   "accepted": true
  },
  {
   "name": "an escaped quote before a comment's markers",
   "text": "{\"format\":\"clack-theme/1\",\"name\":\"a \\\" // b\"}",
   "accepted": true
  },
  {
   "name": "a block comment never closed",
   "text": "{\"format\":\"clack-theme/1\",\"name\":\"N\"} /* end",
   "accepted": false,
   "error": ""
  },
