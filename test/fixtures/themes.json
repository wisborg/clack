  {
   "name": "the annotated example",
   "file": "schema/examples/theme-annotated.json",
   "accepted": true
  },
  {
   "name": "a minimal theme",
   "text": "{\"format\":\"clack-theme/1\",\"name\":\"Mini\"}",
   "accepted": true
  },
  {
   "name": "comments everywhere outside strings",
   "text": "/*a*/{//b\n\"format\"/*c*/:\"clack-theme/1\",//d\r\n\"name\":\"N\"}//e",
   "accepted": true
  },
  {
   "name": "a comment's markers inside a string",
