    { "name": "an unknown part of a place", "set": { "/slides/0/location/place/street": "Bankside" }, "error": "/slides/0/location/place/street" },
    { "name": "a negative file size", "set": { "/slides/0/technical/fileSize": -1 }, "error": "/slides/0/technical/fileSize" },
    { "name": "an empty keyword", "set": { "/slides/0/description/keywords/0": "" }, "error": "/slides/0/description/keywords/0" },
    { "name": "an extra without a label", "set": { "/slides/0/extra/0/label": null }, "error": "/slides/0/extra/0" },
    { "name": "an unknown key with a slash", "set": { "/slides/0/a~1b": 1 }, "error": "/slides/0/a~1b" },
    { "name": "a prototype for a key", "set": { "/slides/0/__proto__": { "alt": "x" } }, "error": "/slides/0/__proto__" }
  ]
