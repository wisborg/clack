{
  "$comment": "Cases for both manifest checkers -- the reference in Go (tools/internal/formats) and Clack's own in the browser (src/manifest.ts) -- so the two cannot drift apart. Each applies its edits to schema/examples/manifest.json (a JSON Pointer to the value to set; null removes it; \"\" replaces the whole document) and says where the error must be, or null for a manifest that must be accepted. A refused case must have an error there and nowhere else.",
  "cases": [
    { "name": "the example as it is", "set": {}, "error": null },
    { "name": "an extension on the manifest", "set": { "/x-site": { "album": 7 } }, "error": null },
    { "name": "an extension on a slide", "set": { "/slides/1/x-note": "kept" }, "error": null },
    { "name": "no slides at all", "set": { "/slides": [] }, "error": null },
    { "name": "an empty alt", "set": { "/slides/0/alt": "" }, "error": null },
    { "name": "a year alone", "set": { "/slides/0/time/taken": "1999" }, "error": null },
    { "name": "a URL with a query and a fragment", "set": { "/slides/0/page": "../low-tide?from=coast#top" }, "error": null },
    { "name": "a percent-encoded name", "set": { "/slides/0/sources/0/url": "photos/%C3%B8-640.avif" }, "error": null },
    { "name": "a whole number written with a point", "set": { "/slides/1/width": 3635.0 }, "error": null },

    { "name": "not an object", "set": { "": ["slides"] }, "error": "" },
    { "name": "no format", "set": { "/format": null }, "error": "" },
    { "name": "the next format", "set": { "/format": "clack-manifest/2" }, "error": "/format" },
    { "name": "no slides", "set": { "/slides": null }, "error": "" },
    { "name": "slides not a list", "set": { "/slides": { "0": {} } }, "error": "/slides" },
