    { "name": "an ISO with a fraction", "set": { "/slides/0/camera/iso": 160.5 }, "error": "/slides/0/camera/iso" },
    { "name": "flash as a word", "set": { "/slides/0/camera/flash": "no" }, "error": "/slides/0/camera/flash" },
    { "name": "a thirteenth month", "set": { "/slides/0/time/taken": "2014-13-01" }, "error": "/slides/0/time/taken" },
    { "name": "a free-form date", "set": { "/slides/0/time/taken": "June 2014" }, "error": "/slides/0/time/taken" },
    { "name": "a latitude alone", "set": { "/slides/0/location": { "latitude": 51.5 } }, "error": "/slides/0/location" },
    { "name": "a latitude off the globe", "set": { "/slides/0/location/latitude": 91 }, "error": "/slides/0/location/latitude" },
    { "name": "a full circle", "set": { "/slides/0/location/direction": 360 }, "error": "/slides/0/location/direction" },
