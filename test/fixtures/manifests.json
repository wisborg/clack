    { "name": "a URL with a letter beyond ASCII", "set": { "/slides/0/sources/0/url": "ø.jpg" }, "error": "/slides/0/sources/0/url" },
    { "name": "a scheme-less colon", "set": { "/slides/0/sources/0/url": "x:y.jpg" }, "error": "/slides/0/sources/0/url" },
    { "name": "a URL that is not a string", "set": { "/slides/0/page": 7 }, "error": "/slides/0/page" },

